{
  "name": "agent-arena-browser-tests",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/znnnnnnn-wil/Agent-Arena.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "node e2e/static-server.cjs",
    "demo:record": "node e2e/record-demo.cjs",
    "build:demo": "node e2e/build-demo.cjs",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test --grep-invert @visual",
    "test:e2e:visual": "playwright test --config playwright.visual.config.js --grep @visual",
    "test:e2e:update": "playwright test --config playwright.visual.config.js --grep @visual --update-snapshots=all"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
